# Copie este arquivo para .env e defina uma senha forte.
# A mesma senha deve ser usada nas duas ocorrências do placeholder em database/setup.sql.
# O arquivo .env é carregado localmente pelo Spring Boot e está ignorado pelo Git.
DB_URL=jdbc:mysql://localhost:3306/soda_caustica_flanges?createDatabaseIfNotExist=true
DB_USERNAME=soda_app
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
